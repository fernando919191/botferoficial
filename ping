export function registrarComandos(bot) {
  // Comando /start
  bot.onText(/\/start/, (msg) => {
    bot.sendMessage(msg.chat.id, "👋 Hola, soy tu bot listo para ayudarte!");
  });

  // Comando /ping
  bot.onText(/\/ping/, (msg) => {
    bot.sendMessage(msg.chat.id, "🏓 Pong!");
  });

  // Aquí puedes seguir agregando más comandos...
}
